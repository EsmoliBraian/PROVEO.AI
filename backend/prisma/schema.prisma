generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  ACTIVE
  OVERDUE
  SUSPENDED
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  REPARTIDOR
}

enum OrderStatus {
  NUEVO
  EN_PROCESO
  EN_CAMINO
  ENTREGADO
  CANCELADO
  /// Confianza de la IA por debajo del umbral — el pedido existe pero un
  /// humano tiene que revisarlo antes de seguir el flujo normal.
  REQUIERE_REVISION
}

enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

enum ProductStockStatus {
  DISPONIBLE
  SIN_STOCK
  PAUSADO
}

/// Un distribuidor (cliente de PROVEO.AI). Toda tabla de negocio cuelga de un tenantId.
model Tenant {
  id                 String             @id @default(cuid())
  name               String
  subscriptionStatus SubscriptionStatus @default(ACTIVE)

  /// Datos de conexión WhatsApp Cloud API de este tenant (Fase 1+, vía Embedded Signup).
  whatsappPhoneNumberId String? @unique
  whatsappWabaId        String?
  /// Access token cifrado (ver TOKEN_ENCRYPTION_KEY) — nunca texto plano.
  whatsappAccessToken   String?

  /// Datos reales para que la IA responda consultas frecuentes sin inventar
  /// (Configuración → Datos del negocio). Null = "no tengo esa información
  /// configurada todavía" en vez de alucinar una respuesta.
  businessHours      String?
  deliveryZone       String?
  deliveryCost       Decimal? @db.Decimal(10, 2)
  paymentMethodsInfo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  products      Product[]
  customers     Customer[]
  orders        Order[]
  conversations Conversation[]

  @@index([whatsappPhoneNumberId])
}

/// Cuenta de acceso al panel. tenantId null solo para SUPER_ADMIN (cross-tenant).
model User {
  id           String  @id @default(cuid())
  tenantId     String?
  tenant       Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role
  name         String
  /// Login del TENANT_ADMIN por email; del REPARTIDOR normalmente por celular.
  email        String? @unique
  phone        String? @unique
  passwordHash String
  /// Permite desactivar un repartidor sin borrarlo (Configuración → Usuarios y Permisos).
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedOrders Order[] @relation("AssignedDriver")

  @@index([tenantId])
}

model Product {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal             @db.Decimal(10, 2)
  stockStatus ProductStockStatus  @default(DISPONIBLE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  aliases     ProductAlias[]
  orderItems  OrderItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Sinónimos con los que un cliente puede nombrar un producto por WhatsApp
/// (ej. "bolsa de hielo" y "bolsita" para el mismo Product) — contexto que
/// tanto el parser por reglas como el parser IA usan para mapear texto libre.
model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantId  String
  alias     String
  createdAt DateTime @default(now())

  @@unique([tenantId, alias])
  @@index([productId])
}

model Customer {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  phones    CustomerPhone[]
  orders    Order[]

  @@index([tenantId])
}

model CustomerPhone {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenantId   String
  phone      String
  createdAt  DateTime @default(now())

  @@unique([tenantId, phone])
  @@index([customerId])
}

model Order {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone   String
  rawMessage      String
  receivedAt      DateTime
  status          OrderStatus @default(NUEVO)
  deliveryAddress String?
  paymentMethod   PaymentMethod?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  /// Repartidor asignado para entregar este pedido (Fase 2).
  assignedDriverId String?
  assignedDriver   User?   @relation("AssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)

  /// Confianza [0,1] que reportó el parser IA (Fase 1) — baja confianza
  /// marca el pedido para revisión humana en el panel en vez de asumir.
  aiConfidence Float?

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]
  /// Conversación que originó este pedido, una vez confirmado (ver Conversation.linkedOrderId).
  conversation Conversation?

  @@index([tenantId, status, receivedAt])
  @@index([tenantId, customerPhone, receivedAt])
  @@index([assignedDriverId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  rawFragment String
  quantity    Int
  matched     Boolean  @default(true)

  @@index([orderId])
}

/// Un hilo de WhatsApp por (tenant, customerPhone) — persiste entre mensajes
/// para que la IA conserve contexto, arme el pedido de a poco y solo lo
/// confirme cuando el cliente lo pide explícitamente.
model Conversation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone  String
  /// Carrito en construcción — mismo shape que los ítems de Order, todavía sin confirmar.
  draftItems     Json?
  lastIntent     String?
  lastConfidence Float?
  linkedOrderId  String?  @unique
  linkedOrder    Order?   @relation(fields: [linkedOrderId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       ConversationMessage[]

  @@unique([tenantId, customerPhone])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// "customer" | "assistant"
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
