# Postgres
POSTGRES_USER=proveo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=proveo
DATABASE_URL=postgresql://proveo:changeme@postgres:5432/proveo

# Backend
PORT=3000
# Secreto para firmar los JWT de sesión (login de TENANT_ADMIN, REPARTIDOR, SUPER_ADMIN).
JWT_SECRET=changeme-jwt-secret
# Clave simétrica para cifrar el access token de WhatsApp de cada tenant en la base.
TOKEN_ENCRYPTION_KEY=changeme-32-bytes-encryption-key

# Frontend
# Vacío a propósito: el frontend llama a rutas relativas /api, que el dev
# server de Vite redirige internamente al backend (mismo patrón que Hielo Guala).
VITE_API_BASE_URL=

TZ=America/Argentina/Buenos_Aires

# Producción únicamente (docker-compose.prod.yml → Caddy).
APP_DOMAIN=

# WhatsApp Cloud API (Meta) — credenciales del NÚMERO de cada tenant (phone_number_id,
# waba_id, access token) se cargan por tenant vía el panel de super-admin, no acá.
# Este token sí es global: es el que vos elegís al configurar el webhook en Meta
# for Developers (Meta te lo devuelve tal cual en la verificación GET).
WHATSAPP_VERIFY_TOKEN=changeme-verify-token

# LLM (Anthropic) para interpretar pedidos de WhatsApp con IA.
ANTHROPIC_API_KEY=

# Producción/Fase 3 — credenciales de la app de Meta (Tech Provider) compartidas
# entre todos los tenants (usadas para el flujo de Embedded Signup).
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
